<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header (drag handle) -->
    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\uD83E\uDDF9 Transfer Session"
            android:textColor="#9AA4B2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/orderToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="#7FB0FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="\uD83D\uDD0D"
            android:textColor="#9AA4B2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="\u21BB"
            android:textColor="#9AA4B2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/minimize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="\u2013"
            android:textColor="#9AA4B2"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="\u2715"
            android:textColor="#E06A6A"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/speciesIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E7EBF0"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9AA4B2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#9AA4B2"
        android:textSize="12sp" />

    <!-- Step 1: search species -->
    <TextView
        android:id="@+id/searchLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="\u2460 Search in Pokemon GO:"
        android:textColor="#E7EBF0"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/searchSpecies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1F2329"
            android:padding="8dp"
            android:textColor="#E7EBF0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/copySpecies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Copy" />
    </LinearLayout>

    <!-- Zones (keepers to favorite, review, trade, transfer) -->
    <ScrollView
        android:id="@+id/zonesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/zones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Step 2: transfer sweep -->
    <TextView
        android:id="@+id/transferLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="\u2461 Then search, select all, Transfer:"
        android:textColor="#E7EBF0"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/transferRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/searchTransfer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1F2329"
            android:padding="8dp"
            android:textColor="#E7EBF0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/copyTransfer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Copy" />
    </LinearLayout>

    <TextView
        android:id="@+id/transferWarn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="8dp"
        android:background="#3A2A12"
        android:textColor="#F2C14E"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Navigation -->
    <LinearLayout
        android:id="@+id/navRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="\u25C0" />

        <Button
            android:id="@+id/skip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Skip" />

        <Button
            android:id="@+id/done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1.4"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="false"
            android:text="Next \u25B6" />
    </LinearLayout>
</LinearLayout>
