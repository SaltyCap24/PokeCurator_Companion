<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F2329">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#E7EBF0"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Floats your cleanup plan above Pokemon GO so you never leave the game."
            android:textColor="#9AA4B2"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. Paste your sync URL"
            android:textColor="#E7EBF0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="From the PokeCurator app: Settings \u2192 Auto-sync with PGSharp \u2192 Copy."
            android:textColor="#9AA4B2"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/syncUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#262B33"
            android:hint="https://\u2026/api/ingest/pgsharp?token=\u2026"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#E7EBF0"
            android:textColorHint="#5B6470" />

        <Button
            android:id="@+id/saveUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save URL" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Allow the overlay"
            android:textColor="#E7EBF0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9AA4B2"
            android:textSize="13sp" />

        <Button
            android:id="@+id/grantOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Grant \u201cDisplay over other apps\u201d" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Start the overlay"
            android:textColor="#E7EBF0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start overlay" />

            <Button
                android:id="@+id/stopOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Stop" />
        </LinearLayout>

        <Button
            android:id="@+id/resetProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Reset cleanup progress" />

    </LinearLayout>
</ScrollView>
