<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F2329">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#E7EBF0"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Companion tools for using your PokéCurator recommendations without leaving Pokémon GO."
            android:textColor="#9AA4B2"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. Paste your sync URL"
            android:textColor="#E7EBF0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="From the PokéCurator app: Settings → Auto-sync with PGSharp → Copy."
            android:textColor="#9AA4B2"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/syncUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#262B33"
            android:hint="https://…/api/ingest/pgsharp?token=…"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#E7EBF0"
            android:textColorHint="#5B6470" />

        <Button
            android:id="@+id/saveUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save URL" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Allow overlays"
            android:textColor="#E7EBF0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9AA4B2"
            android:textSize="13sp" />

        <Button
            android:id="@+id/grantOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Grant “Display over other apps”" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Existing transfer helper"
            android:textColor="#E7EBF0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The current bubble and species-by-species panel. This remains unchanged."
            android:textColor="#9AA4B2"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start helper" />

            <Button
                android:id="@+id/stopOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Stop" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="OCR Grid Assist (experimental)"
            android:textColor="#E7EBF0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A separate full-screen, touch-through overlay. It scans the visible collection grid and will only show destructive recommendations after a high-confidence match."
            android:textColor="#9AA4B2"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startVisionOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Grid Assist" />

            <Button
                android:id="@+id/stopVisionOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Stop" />
        </LinearLayout>

        <Button
            android:id="@+id/resetProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Reset cleanup progress" />

    </LinearLayout>
</ScrollView>
